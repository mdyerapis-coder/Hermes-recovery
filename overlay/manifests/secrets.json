{
  "secret_provider": {
    "backend": "bitwarden",
    "folder_scope": {
      "roots": ["AI & LLM"],
      "include_descendants": true
    },
    "sync": true,
    "interactive_login": true,
    "lock_on_exit": true
  },
  "secrets": [
    {
      "name": "openai",
      "env": "OPENAI_API_KEY",
      "aliases": ["OpenAI", "OpenAI API", "OpenAI API Key", "Hermes OpenAI"],
      "field_names": ["api_key", "openai_api_key", "token", "password"],
      "validator": "token"
    },
    {
      "name": "anthropic",
      "env": "ANTHROPIC_API_KEY",
      "aliases": ["Anthropic", "Claude", "Anthropic API Key", "Claude API Key"],
      "field_names": ["api_key", "anthropic_api_key", "token", "password"],
      "validator": "token"
    },
    {
      "name": "openrouter",
      "env": "OPENROUTER_API_KEY",
      "aliases": ["OpenRouter", "OpenRouter API", "OpenRouter API Key"],
      "field_names": ["api_key", "openrouter_api_key", "token", "password"],
      "validator": "token"
    },
    {
      "name": "huggingface",
      "env": "HF_TOKEN",
      "aliases": ["Hugging Face", "HuggingFace", "HF Token"],
      "field_names": ["token", "hf_token", "api_key", "password"],
      "validator": "token"
    },
    {
      "name": "github",
      "env": "GITHUB_TOKEN",
      "aliases": ["GitHub", "GitHub Token", "GitHub PAT", "Hermes GitHub"],
      "field_names": ["token", "github_token", "pat", "password"],
      "validator": "token"
    },
    {
      "name": "telegram_bot",
      "env": "TELEGRAM_BOT_TOKEN",
      "aliases": ["Telegram", "Telegram Bot", "Hermes Telegram Bot"],
      "field_names": ["bot_token", "telegram_bot_token", "token", "password"],
      "validator": "telegram_bot_token"
    },
    {
      "name": "telegram_allowed_users",
      "env": "TELEGRAM_ALLOWED_USERS",
      "aliases": ["Telegram Allowed Users", "Hermes Telegram Users"],
      "field_names": ["allowed_users", "user_ids", "telegram_allowed_users", "password"],
      "validator": "csv_ids"
    },
    {
      "name": "tailscale",
      "env": "TAILSCALE_AUTH_KEY",
      "aliases": ["Tailscale", "Tailscale Auth Key", "Hermes Tailscale"],
      "field_names": ["auth_key", "tailscale_auth_key", "token", "password"],
      "validator": "tailscale_auth_key"
    }
  ]
}
